{
  "version": "2025.10",
  "name": "neutral",
  "description": "The neutral brand's modes: the colour scheme and the contrast, the foundations' two value axes, and the four sizes of the size axis `device`, desktop, tablet, phone and projector.",
  "sets": {
    "palette": {
      "sources": [
        {
          "$ref": "tokens/palette.tokens.json"
        }
      ]
    },
    "base": {
      "sources": [
        {
          "$ref": "tokens/base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "colour-scheme": {
      "contexts": {
        "light": [],
        "dark": [
          {
            "$ref": "tokens/dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "contrast": {
      "contexts": {
        "standard": [],
        "high": [
          {
            "$ref": "tokens/high-contrast.tokens.json"
          }
        ]
      },
      "default": "standard"
    },
    "device": {
      "contexts": {
        "desktop": [],
        "tablet": [
          {
            "$ref": "tokens/tablet.tokens.json"
          }
        ],
        "phone": [
          {
            "$ref": "tokens/phone.tokens.json"
          }
        ],
        "projector": [
          {
            "$ref": "tokens/projector.tokens.json"
          }
        ]
      },
      "default": "desktop"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/palette"
    },
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/colour-scheme"
    },
    {
      "$ref": "#/modifiers/contrast"
    },
    {
      "$ref": "#/modifiers/device"
    }
  ]
}
