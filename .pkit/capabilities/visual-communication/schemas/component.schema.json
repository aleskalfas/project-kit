{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "A component — visual-communication capability",
  "description": "Formal shape of a component of a library (DEC-001 points 4 and 6, DEC-005 points 1 to 3): its status and what it is about, the fields of content it takes, its options, states, colour, values, the size it prefers, its parts, the parts it exposes, and the layouts of a top component, which may be its pages' forms. `fields` is a fixed subset of JSON Schema 2020-12. Each part is exactly one kind, with the keys that kind takes; a value is a formula or a switch on an option of words. What crosses keys, such as a formula's references and dimensions, a switch naming every word of its option, or a field a part names, the engine checks when it reads the component. Document-shaped schema. Companion per COR-018.",
  "type": "object",
  "required": [
    "pkit_schema",
    "schema_version",
    "status",
    "about"
  ],
  "additionalProperties": false,
  "properties": {
    "pkit_schema": {
      "description": "The schema that binds this file (COR-023; DEC-002 point 3): `visual-communication:component`.",
      "const": "visual-communication:component"
    },
    "schema_version": {
      "description": "The format number, shared by every schema of the capability (DEC-003 point 1).",
      "type": "integer",
      "const": 1
    },
    "status": {
      "description": "What its library promises of it (DEC-003 point 7).",
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "about": {
      "description": "What the component is for, in words.",
      "$ref": "defs.schema.json#/$defs/text"
    },
    "fields": {
      "description": "The content it takes.",
      "$ref": "#/$defs/field-schema"
    },
    "options": {
      "description": "Its options, by name: words, or an item (and its point) of a list it declares.",
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "$ref": "defs.schema.json#/$defs/name"
          },
          {
            "not": {
              "enum": [
                "id",
                "use",
                "concept",
                "state",
                "override",
                "pkit"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/option"
      }
    },
    "states": {
      "description": "Its states, by name, each with the colour family it paints with.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "colour": {
      "description": "Its default colour family.",
      "$ref": "defs.schema.json#/$defs/name"
    },
    "values": {
      "description": "Its named values, by name, each a formula or a switch of them.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/number-value"
      }
    },
    "preferred": {
      "description": "The size it asks for.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/number-value"
        },
        "height": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "parts": {
      "description": "Its parts, by name, drawn in order.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "exposes": {
      "description": "The parts a component that places it may read; an exposed image exposes its picture's points too.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/name"
      }
    },
    "layouts": {
      "description": "A top component's layouts, by name: one, whose slots name the top's fields; or, where the layouts are the forms its pages take, one or more, each drawing a page with its own parts.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layout"
      },
      "anyOf": [
        {
          "maxProperties": 1
        },
        {
          "additionalProperties": {
            "required": [
              "parts"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "field-schema": {
      "description": "The subset of JSON Schema 2020-12 a component's `fields` takes in format 1 (v3 of the walking skeleton's design): `type`, `properties`, `required`, `items`, `minItems`, `maxItems`, `enum`, `const`, `description`, `x-pkit-prose`, `x-pkit-pages`, a local `$ref`, and `additionalProperties` only as `false`, which its absence means too. No property takes a reserved key's name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "object",
                  "array",
                  "null"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "not": {
                  "enum": [
                    "id",
                    "use",
                    "concept",
                    "state",
                    "override",
                    "pkit"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/field-schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "not": {
                  "enum": [
                    "id",
                    "use",
                    "concept",
                    "state",
                    "override",
                    "pkit"
                  ]
                }
              }
            ]
          },
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/field-schema"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "const": {},
        "description": {
          "type": "string"
        },
        "x-pkit-prose": {
          "type": "boolean"
        },
        "x-pkit-pages": {
          "description": "The field holds a top component's pages, each in one of its layouts. Only a list field of the top's own fields takes it.",
          "const": true
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/"
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "formula": {
      "description": "A formula: text that starts with `=` and computes one number from numbers, `+ - * /`, parentheses, `min max round`, roles (`@<token path>`), the engine's names (`:width :height :index :count`), the component's values and the frames it may reach (DEC-005 points 1 and 3). The engine checks what it reads and its dimensions.",
      "type": "string",
      "pattern": "^="
    },
    "number-value": {
      "description": "A number the component computes: a formula, or a switch on an option of words, each word a number-value.",
      "anyOf": [
        {
          "$ref": "#/$defs/formula"
        },
        {
          "$ref": "#/$defs/number-switch"
        }
      ]
    },
    "number-switch": {
      "description": "A switch: `by` names an option of words, and every word of it a value.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/number-value"
      }
    },
    "paint": {
      "description": "A paint: a colour role's token path, or `:colour.<member>`, a member of the instance's colour family; or a switch on an option of words, whose branch may be null to paint nothing.",
      "anyOf": [
        {
          "$ref": "defs.schema.json#/$defs/token-path"
        },
        {
          "type": "string",
          "pattern": "^:colour\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "$ref": "#/$defs/paint-switch"
        }
      ]
    },
    "paint-switch": {
      "description": "A switch of paints: `by` names an option of words; a word's paint may be null.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/paint"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "role-value": {
      "description": "A role by its token path, such as a text's typography; or a switch of them on an option of words.",
      "anyOf": [
        {
          "$ref": "defs.schema.json#/$defs/token-path"
        },
        {
          "$ref": "#/$defs/role-switch"
        }
      ]
    },
    "role-switch": {
      "description": "A switch of roles on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/role-value"
      }
    },
    "word-value": {
      "description": "A word of an option a placed component declares; or a switch of words on an option of words of this component.",
      "anyOf": [
        {
          "$ref": "defs.schema.json#/$defs/name"
        },
        {
          "$ref": "#/$defs/word-switch"
        }
      ]
    },
    "word-switch": {
      "description": "A switch of words on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/word-value"
      }
    },
    "text-anchor-value": {
      "description": "`text-anchor`: one of start, middle, end, the first the default; or a switch of them on an option of words.",
      "anyOf": [
        {
          "enum": [
            "start",
            "middle",
            "end"
          ]
        },
        {
          "$ref": "#/$defs/text-anchor-switch"
        }
      ]
    },
    "text-anchor-switch": {
      "description": "A switch of `text-anchor` words on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/text-anchor-value"
      }
    },
    "align-items-value": {
      "description": "`align-items`: one of stretch, start, center, end, the first the default; or a switch of them on an option of words.",
      "anyOf": [
        {
          "enum": [
            "stretch",
            "start",
            "center",
            "end"
          ]
        },
        {
          "$ref": "#/$defs/align-items-switch"
        }
      ]
    },
    "align-items-switch": {
      "description": "A switch of `align-items` words on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/align-items-value"
      }
    },
    "justify-content-value": {
      "description": "`justify-content`: one of start, center, end, space-between, the first the default; or a switch of them on an option of words.",
      "anyOf": [
        {
          "enum": [
            "start",
            "center",
            "end",
            "space-between"
          ]
        },
        {
          "$ref": "#/$defs/justify-content-switch"
        }
      ]
    },
    "justify-content-switch": {
      "description": "A switch of `justify-content` words on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/justify-content-value"
      }
    },
    "sizes-value": {
      "description": "`sizes`: one of own, equal, the first the default; or a switch of them on an option of words.",
      "anyOf": [
        {
          "enum": [
            "own",
            "equal"
          ]
        },
        {
          "$ref": "#/$defs/sizes-switch"
        }
      ]
    },
    "sizes-switch": {
      "description": "A switch of `sizes` words on an option of words.",
      "type": "object",
      "required": [
        "by"
      ],
      "minProperties": 2,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "properties": {
        "by": {
          "description": "The option of words the value switches on.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/sizes-value"
      }
    },
    "when": {
      "description": "When a part is drawn: while a field of the content is filled, or while an option of words takes one of the words named.",
      "anyOf": [
        {
          "$ref": "defs.schema.json#/$defs/name"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "$ref": "defs.schema.json#/$defs/name"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "defs.schema.json#/$defs/name"
                }
              }
            ]
          }
        }
      ]
    },
    "option": {
      "description": "An option: a list of words, the first the default; or `{item: <list field>}`, naming an item of that list by its id; or `{item: <list field>, point: true}`, naming an item and one of its exposed points.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "not": {
                  "const": "by"
                }
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "item": {
              "$ref": "defs.schema.json#/$defs/name"
            },
            "point": {
              "const": true
            }
          }
        }
      ]
    },
    "state": {
      "description": "A state: the colour family it paints with, or `{}` to keep the instance's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colour": {
          "description": "The colour family the state paints with.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      }
    },
    "layout": {
      "description": "A layout of a top component. In format 1 its slots name the top's fields. In a layout that is a page's form, each slot is the schema of a field the page fills, `required` names the slots a page must fill, and `parts` draw the page.",
      "type": "object",
      "required": [
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "slots": {
          "description": "The slots of the layout, each a field the content fills.",
          "type": "object",
          "propertyNames": {
            "$ref": "defs.schema.json#/$defs/name"
          }
        },
        "required": {
          "description": "The slots a page in this layout must fill.",
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/name"
          },
          "uniqueItems": true
        },
        "parts": {
          "description": "The parts that draw a page in this layout, by name, drawn in order.",
          "type": "object",
          "propertyNames": {
            "$ref": "defs.schema.json#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/part"
          }
        }
      },
      "if": {
        "required": [
          "parts"
        ]
      },
      "then": {
        "properties": {
          "slots": {
            "propertyNames": {
              "not": {
                "enum": [
                  "layout",
                  "id",
                  "use",
                  "concept",
                  "state",
                  "override",
                  "pkit"
                ]
              }
            },
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/$defs/field-schema"
                },
                {
                  "not": {
                    "required": [
                      "x-pkit-pages"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "required"
          ]
        },
        "properties": {
          "slots": {
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pages": {
                  "description": "The slot's items are pages.",
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "box": {
      "description": "A box's properties, by SVG's names.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "stroke-width": {
          "$ref": "#/$defs/number-value"
        },
        "rx": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "ellipse": {
      "description": "An ellipse's properties, by SVG's names.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "stroke-width": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "text": {
      "description": "A text's properties: the field it shows, its typography role, and SVG's names.",
      "type": "object",
      "required": [
        "content",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "The field of text it shows.",
          "$ref": "defs.schema.json#/$defs/name"
        },
        "style": {
          "$ref": "#/$defs/role-value"
        },
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "text-anchor": {
          "$ref": "#/$defs/text-anchor-value"
        }
      }
    },
    "line": {
      "description": "A line's properties, by SVG's names.",
      "type": "object",
      "required": [
        "stroke"
      ],
      "additionalProperties": false,
      "properties": {
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "stroke-width": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "image": {
      "description": "An image's properties: the produced output it shows.",
      "type": "object",
      "required": [
        "produced"
      ],
      "additionalProperties": false,
      "properties": {
        "produced": {
          "description": "The field naming a produced output of the piece.",
          "$ref": "defs.schema.json#/$defs/name"
        }
      }
    },
    "operator": {
      "description": "How a list's items are arranged along a row or a column, by CSS flexible layout's names.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap": {
          "$ref": "#/$defs/number-value"
        },
        "align-items": {
          "$ref": "#/$defs/align-items-value"
        },
        "justify-content": {
          "$ref": "#/$defs/justify-content-value"
        },
        "sizes": {
          "$ref": "#/$defs/sizes-value"
        }
      }
    },
    "box-part": {
      "description": "A box.",
      "type": "object",
      "required": [
        "box",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "box": {
          "$ref": "#/$defs/box"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "x": {
          "$ref": "#/$defs/number-value"
        },
        "y": {
          "$ref": "#/$defs/number-value"
        },
        "width": {
          "$ref": "#/$defs/number-value"
        },
        "height": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "ellipse-part": {
      "description": "An ellipse.",
      "type": "object",
      "required": [
        "ellipse",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "ellipse": {
          "$ref": "#/$defs/ellipse"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "x": {
          "$ref": "#/$defs/number-value"
        },
        "y": {
          "$ref": "#/$defs/number-value"
        },
        "width": {
          "$ref": "#/$defs/number-value"
        },
        "height": {
          "$ref": "#/$defs/number-value"
        }
      }
    },
    "text-part": {
      "description": "A text: its height is its measured text's, so it gives none.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "x": {
          "$ref": "#/$defs/number-value"
