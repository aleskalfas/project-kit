{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "A component — visual-communication capability",
  "description": "Formal shape of a component of a library (DEC-001 points 4 and 6, DEC-005 points 1 to 3): its status and what it is about, the fields of content it takes, its options, states, colour, values, parts, the parts and points it exposes, the size it prefers, the layouts of a top component, and the components it defines. `fields` is a fixed subset of JSON Schema 2020-12. Document-shaped schema. Companion per COR-018.",
  "type": "object",
  "required": [
    "pkit_schema",
    "schema_version",
    "status",
    "about"
  ],
  "additionalProperties": false,
  "properties": {
    "pkit_schema": {
      "description": "The schema that binds this file (COR-023; DEC-002 point 3): `visual-communication:component`.",
      "const": "visual-communication:component"
    },
    "schema_version": {
      "description": "The format number, shared by every schema of the capability (DEC-003 point 1).",
      "type": "integer",
      "const": 1
    },
    "status": {
      "description": "What its library promises of it (DEC-003 point 7).",
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "about": {
      "description": "What the component is for, in words.",
      "$ref": "defs.schema.json#/$defs/text"
    },
    "fields": {
      "description": "The content it takes.",
      "$ref": "#/$defs/field-schema"
    },
    "options": {
      "description": "Its options, by name; their shape is the engine's.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": true
    },
    "states": {
      "description": "Its states, by name; their shape is the engine's.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": true
    },
    "colour": {
      "description": "Its default colour; its shape is the engine's."
    },
    "values": {
      "description": "Its named values, by name; their shape is the engine's.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": true
    },
    "parts": {
      "description": "Its parts, drawn in order; their shape is the engine's."
    },
    "exposes": {
      "description": "The parts and points it lets others read; their shape is the engine's."
    },
    "preferred": {
      "description": "The size it asks for; its shape is the engine's."
    },
    "layouts": {
      "description": "A top component's layouts, by name, each with its slots; a slot may hold pages.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "slots"
        ],
        "properties": {
          "slots": {
            "type": "object",
            "propertyNames": {
              "$ref": "defs.schema.json#/$defs/name"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "pages": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "define": {
      "description": "The components it defines for its own use, by name.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/name"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "field-schema": {
      "description": "The subset of JSON Schema 2020-12 a component's `fields` takes in format 1 (v3 of the walking skeleton's design): `type`, `properties`, `required`, `items`, `minItems`, `maxItems`, `enum`, `const`, `description`, `x-pkit-prose`, a local `$ref`, and `additionalProperties` only as `false`, which its absence means too. No property takes a reserved key's name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "object",
                  "array",
                  "null"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "not": {
                  "enum": [
                    "id",
                    "use",
                    "concept",
                    "state",
                    "override",
                    "pkit"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/field-schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "defs.schema.json#/$defs/name"
              },
              {
                "not": {
                  "enum": [
                    "id",
                    "use",
                    "concept",
                    "state",
                    "override",
                    "pkit"
                  ]
                }
              }
            ]
          },
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/field-schema"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "const": {},
        "description": {
          "type": "string"
        },
        "x-pkit-prose": {
          "type": "boolean"
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/"
        },
        "additionalProperties": {
          "const": false
        }
      }
    }
  }
}
