{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "values.schema.json",
  "title": "The document of a brand's resolved values, version 1 — visual-communication capability",
  "description": "Formal shape of the values document, version 1 (DEC-005 points 7 and 8): each token by its token path, with its DTCG type and its value in each combination, named by the combination's key. The `json` code writer writes it unchanged as its form 1, so code outside the capability reads this shape. A later version takes a schema of its own, beside this one. Stands alone like `defs.schema.json`: no file of the capability's format binds to it.",
  "type": "object",
  "required": [
    "document",
    "version",
    "lock",
    "keys",
    "tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "document": {
      "description": "What the file is: always `visual-communication/values`.",
      "const": "visual-communication/values"
    },
    "version": {
      "description": "The document's version, apart from the format number of the files a project keeps (DEC-005 point 8).",
      "const": 1
    },
    "lock": {
      "description": "The version of each library the values were resolved under.",
      "$ref": "defs.schema.json#/$defs/lock",
      "minProperties": 1
    },
    "keys": {
      "description": "Each combination the document holds, by its key, in key order: `default` first where it holds it.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/key"
      }
    },
    "tokens": {
      "description": "Each token, by its token path.",
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/token-path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/token"
      }
    }
  },
  "$defs": {
    "token": {
      "description": "One token: its DTCG type, and its value in each combination, by the combination's key.",
      "type": "object",
      "required": [
        "type",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "fontWeight",
            "number",
            "typography"
          ]
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "defs.schema.json#/$defs/key"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "color"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dimension"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/dimension"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fontFamily"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/font-family"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fontWeight"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/font-weight"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "typography"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "additionalProperties": {
                  "$ref": "#/$defs/typography"
                }
              }
            }
          }
        }
      ]
    },
    "color": {
      "description": "A colour in its canonical DTCG form: sRGB, each component and `alpha` from 0 to 1, with `alpha` always and `hex` never.",
      "type": "object",
      "required": [
        "colorSpace",
        "components",
        "alpha"
      ],
      "additionalProperties": false,
      "properties": {
        "colorSpace": {
          "const": "srgb"
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "dimension": {
      "description": "A length in px.",
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "px"
        }
      }
    },
    "font-family": {
      "description": "A font family in its canonical form: a list of names, even of one.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "defs.schema.json#/$defs/text"
      }
    },
    "font-weight": {
      "description": "A font weight, from 1 to 1000.",
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "number": {
      "description": "A number with no unit.",
      "type": "number"
    },
    "typography": {
      "description": "A typography: its five members, each resolved to its own type.",
      "type": "object",
      "required": [
        "fontFamily",
        "fontSize",
        "fontWeight",
        "letterSpacing",
        "lineHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "$ref": "#/$defs/font-family"
        },
        "fontSize": {
          "$ref": "#/$defs/dimension"
        },
        "fontWeight": {
          "$ref": "#/$defs/font-weight"
        },
        "letterSpacing": {
          "$ref": "#/$defs/dimension"
        },
        "lineHeight": {
          "$ref": "#/$defs/number"
        }
      }
    }
  }
}
