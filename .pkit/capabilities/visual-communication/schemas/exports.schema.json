{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports.schema.json",
  "title": "The record of a piece's exports — visual-communication capability",
  "description": "Formal shape of a piece's `exports.yaml` (DEC-006 point 7): each numbered export, with the fingerprint of every file its scenes were computed from and the formats it made (form 1), each file it made with its hash, and what is only recorded. `pkit visual export` rewrites it. Document-shaped schema. Companion per COR-018.",
  "type": "object",
  "required": [
    "pkit_schema",
    "schema_version",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "pkit_schema": {
      "description": "The schema that binds this file (COR-023; DEC-002 point 3): `visual-communication:exports`.",
      "const": "visual-communication:exports"
    },
    "schema_version": {
      "description": "The format number, shared by every schema of the capability (DEC-003 point 1).",
      "type": "integer",
      "const": 1
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "fingerprint",
          "files",
          "recorded"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "fingerprint": {
            "$ref": "defs.schema.json#/$defs/fingerprint"
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.v[1-9][0-9]*\\.[a-z]{2,3}(-[a-z0-9]{2,8})*\\.(default|[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*(\\+[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)*)\\.svg$"
            },
            "additionalProperties": {
              "$ref": "defs.schema.json#/$defs/sha256"
            },
            "minProperties": 1
          },
          "recorded": {
            "type": "object",
            "required": [
              "time",
              "state",
              "capability",
              "renderers",
              "used-stale"
            ],
            "additionalProperties": false,
            "properties": {
              "time": {
                "$ref": "defs.schema.json#/$defs/time"
              },
              "state": {
                "const": "draft"
              },
              "capability": {
                "$ref": "defs.schema.json#/$defs/release"
              },
              "renderers": {
                "$ref": "defs.schema.json#/$defs/plugins"
              },
              "used-stale": {
                "type": "array",
                "items": {
                  "$ref": "defs.schema.json#/$defs/name"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
