{
  "$description": "The test brand at its defaults: the light colour scheme, standard contrast.",
  "scheme": {
    "$description": "What each colour scheme paints with; private. The dark scheme redefines it.",
    "$type": "color",
    "paper": {
      "$value": "{palette.white}"
    },
    "raised": {
      "$value": "{palette.grey.50}"
    },
    "ink": {
      "$value": "{palette.grey.900}"
    },
    "ink-soft": {
      "$value": "{palette.grey.600}"
    },
    "rule": {
      "$value": "{palette.grey.200}"
    },
    "accent": {
      "$value": "{palette.blue.600}"
    },
    "strong-ink": {
      "$value": "{palette.black}"
    },
    "strong-paper": {
      "$value": "{palette.white}"
    }
  },
  "background": {
    "$type": "color",
    "$value": "{scheme.paper}"
  },
  "surface": {
    "$type": "color",
    "$value": "{scheme.raised}"
  },
  "text-primary": {
    "$type": "color",
    "$value": "{scheme.ink}"
  },
  "text-secondary": {
    "$type": "color",
    "$value": "{scheme.ink-soft}"
  },
  "accent": {
    "$type": "color",
    "$value": "{scheme.accent}"
  },
  "line": {
    "$type": "color",
    "$value": "{scheme.rule}"
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "figure": {
      "$description": "The width of a figure's page.",
      "$value": {
        "value": 960,
        "unit": "px"
      }
    }
  },
  "stroke": {
    "$type": "dimension",
    "thin": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": [
        "Source Sans Pro"
      ],
      "$extensions": {
        "pkit.visual-communication": {
          "files": {
            "Source Sans Pro": "fonts/SourceSansPro-Regular.otf"
          },
          "measure": "file"
        }
      }
    },
    "heading": {
      "$value": [
        "Source Sans Pro Semibold"
      ],
      "$extensions": {
        "pkit.visual-communication": {
          "files": {
            "Source Sans Pro Semibold": "fonts/SourceSansPro-Semibold.otf"
          },
          "measure": "file"
        }
      }
    }
  },
  "type": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.4
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.heading}",
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.2
      }
    }
  }
}
